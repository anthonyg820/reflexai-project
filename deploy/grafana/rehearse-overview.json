{
  "title": "Rehearse overview",
  "uid": "rehearse-overview",
  "schemaVersion": 39,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "rehearse"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "#8e5cd9",
        "target": {
          "type": "tags",
          "tags": [
            "deploy"
          ],
          "limit": 100,
          "matchAny": true
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API requests / s by cloud \u00d7 env",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cloud_provider, deployment_environment_name) (rate(http_server_request_duration_seconds_count{job=~\".*rehearse-api\"}[1m]))",
          "legendFormat": "{{cloud_provider}} / {{deployment_environment_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API 5xx ratio (alert above 2%)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cloud_provider, deployment_environment_name) (rate(http_server_request_duration_seconds_count{job=~\".*rehearse-api\", http_response_status_code=~\"5..\"}[5m])) / sum by (cloud_provider, deployment_environment_name) (rate(http_server_request_duration_seconds_count{job=~\".*rehearse-api\"}[5m]))",
          "legendFormat": "{{cloud_provider}} / {{deployment_environment_name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API p95 latency",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, cloud_provider, deployment_environment_name) (rate(http_server_request_duration_seconds_bucket{job=~\".*rehearse-api\"}[5m])))",
          "legendFormat": "{{cloud_provider}} / {{deployment_environment_name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Sessions completed / min by rubric",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rehearse_rubric, cloud_provider) (rate(rehearse_sessions_completed_total[5m])) * 60",
          "legendFormat": "{{cloud_provider}} {{rehearse_rubric}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Running versions",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (job, cloud_provider, deployment_environment_name, service_version) (http_server_request_duration_seconds_count)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            }
          }
        }
      ]
    }
  ]
}