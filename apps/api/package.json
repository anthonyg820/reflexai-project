{
  "name": "@rehearse/api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --require ./dist/otel.js dist/main.js",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch --require ./dist/otel.js dist/main.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@opentelemetry/api": "1.9.0",
    "@rehearse/config": "workspace:*",
    "@rehearse/telemetry": "workspace:*",
    "@rehearse/types": "workspace:*",
    "drizzle-orm": "0.44.7",
    "nestjs-pino": "4.6.1",
    "pg": "8.16.3",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/core": "1.13.21",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "concurrently": "9.2.5",
    "supertest": "7.1.4",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
